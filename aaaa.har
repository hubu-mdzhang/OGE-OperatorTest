          "postData": {
            "mimeType": "application/json",
            "text": "{\"code\":\"import oge\\n# 初始化\\noge.initialize()\\nservice = oge.Service.initialize()\\n# 加载矢量\\ngeometry1 = service.getProcess(\\\"Geometry.Polygon\\\").execute([[[35, 10], [35, 15], [40, 15], [40, 10], [35, 10]]],\\\"EPSG:4326\\\")\\nfeature1 = service.getProcess(\\\"Feature.loadFromGeometry\\\").execute(geometry1, {\\\"a\\\":10})\\ngeometry2 = service.getProcess(\\\"Geometry.Polygon\\\").execute([[[38, 10], [38, 15], [43, 15], [43, 10], [38, 10]]],\\\"EPSG:4326\\\")\\nfeature2 = service.getProcess(\\\"Feature.loadFromGeometry\\\").execute(geometry2, {\\\"a\\\":10})\\n\\nsymmetricDifference = service.getProcess(\\\"Feature.symmetricDifference\\\").execute(feature1,feature2,\\\"EPSG:4326\\\")\\nfeature1.styles([\\\"#000000\\\"]).getMap(\\\"feature1\\\")\\nfeature2.styles([\\\"#111111\\\"]).getMap(\\\"feature2\\\")\\nsymmetricDifference.styles([\\\"#FF0000\\\"]).getMap(\\\"symmetricDifference\\\")\\n\\noge.mapclient.centerMap(37,12,5)\\n\",\"userId\":\"<OGE_USER_ID>\",\"sampleName\":\"\"}"
          }
        },
